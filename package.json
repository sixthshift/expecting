{
  "name": "expecting",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host",
    "build": "NODE_ENV=production bun --bun vite build",
    "start": "PORT=${PORT:-9966} bun run .output/server/index.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun --bun vitest run",
    "e2e": "$(command -v flock >/dev/null && echo flock /tmp/expecting-e2e.lock) playwright test -c e2e",
    "migrate": "bun run src/db/migrations/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "version:next": "bun run scripts/version.ts",
    "names": "bun run scripts/names.ts",
    "palette": "bun run scripts/palette.ts && bun run scripts/palette-sheet.ts",
    "components:sheet": "bun run scripts/components-sheet.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@markdoc/markdoc": "^0.5.11",
    "@sixthshift/design-system": "^0.12.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.511.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
