                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/db/**", "bun:sqlite", "drizzle-orm", "drizzle-orm/**"],
