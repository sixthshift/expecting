{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.css", "**/*.json", "!.output", "!.nitro", "!.tanstack", "!.vite", "!data", "!public/sw.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 160
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noExportsInTest": "off",
            "noTemplateCurlyInString": "off",
            "noNonNullAssertedOptionalChain": "off"
          },
          "correctness": {
            "useHookAtTopLevel": "off",
            "noUnsafeOptionalChaining": "off",
            "noEmptyCharacterClassInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["src/styles/index.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "correctness": {
            "noInvalidPositionAtImportRule": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/db/**", "!src/server/**", "!src/api/**", "!src/routes/**", "!src/router.tsx", "!src/server.ts", "!src/start.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/db/**", "bun:sqlite", "drizzle-orm", "drizzle-orm/**"],
                    "message": "The store is server only: import types and rules from src/lib/, and data through a server function."
                  },
                  {
                    "group": ["**/server/**"],
                    "message": "Server only: the browser reaches the server through a server function in src/api/rpc/."
                  },
                  {
                    "group": ["**/api/rest", "**/api/rest/**"],
                    "message": "The /api/* server routes are server only: the app calls the server through src/api/rpc/."
                  },
                  {
                    "group": ["**/routes/**"],
                    "message": "Routes are definitions only and nothing imports them: read a route's data with getRouteApi."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/routes/**", "src/router.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/db/**", "bun:sqlite", "drizzle-orm", "drizzle-orm/**"],
                    "message": "The store is server only: import types and rules from src/lib/, and data through a server function."
                  },
                  {
                    "group": ["**/server/**"],
                    "message": "Server only: the browser reaches the server through a server function in src/api/rpc/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/db/**", "bun:sqlite", "drizzle-orm", "drizzle-orm/**"],
